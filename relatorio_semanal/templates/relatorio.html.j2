<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ c.eyebrow }} · {{ c.titulo }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --accent:{{ tema.accent }};
    --accent-soft:{{ tema.accent_soft }};
    --bg:{{ tema.bg }};
    --surface:{{ tema.surface }};
    --text:{{ tema.text }};
    --muted:{{ tema.muted }};
    --ok:#22C55E; --alerta:#F59E0B; --ruim:#EF4444; --neutro:#71717A; --azul:#3B82F6;
    --font-display:"{{ tema.font_display }}",system-ui,sans-serif;
    --font-body:"{{ tema.font_body }}",system-ui,sans-serif;
    --radius:14px;
  }
  *{box-sizing:border-box}
  html,body{margin:0;background:var(--bg);color:var(--text);font-family:var(--font-body);font-size:15px;line-height:1.55}
  a{color:var(--accent)}
  .wrap{max-width:960px;margin:0 auto;padding:32px 20px 64px}
  @keyframes rise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
  .anim{animation:rise .6s ease both}
  .anim:nth-child(2){animation-delay:.08s}.anim:nth-child(3){animation-delay:.16s}.anim:nth-child(4){animation-delay:.24s}
  .anim:nth-child(5){animation-delay:.32s}.anim:nth-child(6){animation-delay:.40s}.anim:nth-child(7){animation-delay:.48s}

  .hero{position:relative;padding:36px 32px;border-radius:20px;overflow:hidden;
        background:radial-gradient(120% 140% at 0% 0%,color-mix(in srgb,var(--accent) 28%,transparent),transparent 60%),var(--surface);
        border:1px solid color-mix(in srgb,var(--accent) 35%,transparent)}
  .eyebrow{font-family:var(--font-display);font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);font-weight:700}
  .hero h1{font-family:var(--font-display);font-size:clamp(26px,4vw,38px);line-height:1.1;margin:10px 0 14px;font-weight:700}
  .hero p{margin:0;color:var(--text);max-width:70ch;font-size:16px}
  .selo{position:absolute;top:20px;right:20px;font-family:var(--font-display);font-weight:700;font-size:13px;
        border:2px solid var(--accent);color:var(--accent);border-radius:999px;padding:4px 10px}
  .hero.sem-midia{border-color:var(--ruim);background:radial-gradient(120% 140% at 0% 0%,rgba(239,68,68,.25),transparent 60%),var(--surface)}
  .hero.sem-midia .eyebrow{color:var(--ruim)}

  section{margin-top:36px}
  .sec-h{display:flex;align-items:baseline;gap:12px;margin-bottom:14px}
  .sec-h .num{font-family:var(--font-display);color:var(--accent);font-weight:700;font-size:13px;letter-spacing:.12em}
  .sec-h h2{font-family:var(--font-display);font-size:20px;margin:0;font-weight:700}

  .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}
  .metric{background:var(--surface);border:1px solid #27272A;border-radius:var(--radius);padding:16px 18px;border-top:3px solid var(--neutro)}
  .metric.ok{border-top-color:var(--ok)}.metric.alerta{border-top-color:var(--alerta)}.metric.ruim{border-top-color:var(--ruim)}
  .metric .l{font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.08em}
  .metric .v{font-family:var(--font-display);font-size:28px;font-weight:700;margin:4px 0 2px}
  .metric.ok .v{color:var(--ok)}.metric.alerta .v{color:var(--alerta)}.metric.ruim .v{color:var(--ruim)}
  .metric .s{font-size:12px;color:var(--muted)}

  .note{border-radius:var(--radius);padding:14px 18px;background:var(--surface);border:1px solid #27272A;border-left:4px solid var(--muted);margin-top:12px}
  .note.red{border-left-color:var(--ruim);background:color-mix(in srgb,var(--ruim) 10%,var(--surface))}
  .note.blue{border-left-color:var(--azul);background:color-mix(in srgb,var(--azul) 10%,var(--surface))}
  .note.amber{border-left-color:var(--alerta);background:color-mix(in srgb,var(--alerta) 10%,var(--surface))}
  .note h3{margin:0 0 6px;font-family:var(--font-display);font-size:15px}
  .note ol,.note ul{margin:6px 0 0;padding-left:20px}
  .note li{margin:4px 0}

  .qs{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px}
  .q{background:var(--surface);border:1px solid #27272A;border-radius:var(--radius);padding:18px}
  .q.wide{grid-column:1/-1}
  .q.wide ul{columns:2;column-gap:24px}
  @media (max-width:640px){.q.wide ul{columns:1}}
  .q .qn{font-family:var(--font-display);color:var(--accent);font-size:12px;letter-spacing:.12em;font-weight:700}
  .q h3{margin:4px 0 8px;font-family:var(--font-display);font-size:17px}
  .q .ver{font-weight:600;margin:0 0 8px}
  .q ul{margin:0;padding-left:18px;color:var(--muted);font-size:13.5px}
  .q li{margin:3px 0}
  .tag{display:inline-block;font-size:11px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;padding:2px 8px;border-radius:999px;
       background:color-mix(in srgb,var(--neutro) 25%,transparent);color:var(--text)}
  .tag.ok{background:color-mix(in srgb,var(--ok) 22%,transparent);color:var(--ok)}
  .tag.alerta{background:color-mix(in srgb,var(--alerta) 22%,transparent);color:var(--alerta)}
  .tag.ruim{background:color-mix(in srgb,var(--ruim) 22%,transparent);color:var(--ruim)}

  .tbl-wrap{overflow-x:auto;border-radius:var(--radius);border:1px solid #27272A;background:var(--surface)}
  .tbl{width:100%;border-collapse:collapse;font-size:14px;min-width:560px}
  .tbl th{text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);padding:12px 14px;border-bottom:1px solid #27272A}
  .tbl td{padding:11px 14px;border-bottom:1px solid #1F1F23}
  .tbl tr:last-child td{border-bottom:0}
  .tbl td.num{text-align:right;font-variant-numeric:tabular-nums}
  .tbl th.num{text-align:right}
  .small{font-size:12.5px;color:var(--muted);margin-top:8px}

  footer{margin-top:48px;padding-top:18px;border-top:1px solid #27272A;color:var(--muted);font-size:12.5px;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}
  footer b{color:var(--accent);font-family:var(--font-display)}
</style>
</head>
<body>
<div class="wrap">

  <header class="hero anim{% if c.sem_midia %} sem-midia{% endif %}">
    <div class="eyebrow">{{ c.eyebrow }}</div>
    <h1>{{ c.titulo }}</h1>
    <p>{{ c.resumo }}</p>
    <span class="selo">+18</span>
  </header>

  <section class="anim">
    <div class="sec-h"><span class="num">01</span><h2>Operação na semana</h2></div>
    <div class="grid">
      {% for card in c.cards %}
      <div class="metric {{ card.cor }}">
        <div class="l">{{ card.rotulo }}</div>
        <div class="v">{{ card.valor }}</div>
        <div class="s">{{ card.sub }}</div>
      </div>
      {% endfor %}
    </div>
    <div class="note">{{ c.contexto }}</div>
    {% if c.avisos %}
    <div class="note amber"><h3>Avisos de dado</h3><ul>{% for a in c.avisos %}<li>{{ a }}</li>{% endfor %}</ul></div>
    {% endif %}
  </section>

  <section class="anim">
    <div class="sec-h"><span class="num">02</span><h2>As 4 respostas</h2></div>
    <div class="qs">
      {% for r in c.respostas %}
      <div class="q{% if loop.last %} wide{% endif %}">
        <div class="qn">{{ r.numero }} <span class="tag {{ r.tag }}">{{ {'ok':'ok','alerta':'atenção','ruim':'crítico','neutro':'leitura'}[r.tag] }}</span></div>
        <h3>{{ r.titulo }}</h3>
        <p class="ver">{{ r.veredito }}</p>
        {% if r.corpo %}<ul>{% for li in r.corpo %}<li>{{ li }}</li>{% endfor %}</ul>{% endif %}
      </div>
      {% endfor %}
    </div>
  </section>

  <section class="anim">
    <div class="sec-h"><span class="num">03</span><h2>Leitura por formato / multiplicador</h2></div>
    {% if c.tabela %}
    <div class="tbl-wrap">
    <table class="tbl">
      <thead><tr><th>Grupo</th><th class="num">N</th><th class="num">Invest</th><th class="num">C/Lead</th><th class="num">FTD</th><th class="num">C/FTD</th><th>Status</th></tr></thead>
      <tbody>
      {% for l in c.tabela %}
      <tr><td>{{ l.grupo }}</td><td class="num">{{ l.n }}</td><td class="num">{{ l.invest }}</td><td class="num">{{ l.c_lead }}</td><td class="num">{{ l.ftd }}</td><td class="num">{{ l.c_ftd }}</td><td><span class="tag {{ l.status_cor }}">{{ l.status }}</span></td></tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
    {% endif %}
    <p class="small">{{ c.tabela_nota }}</p>
  </section>

  <section class="anim">
    <div class="sec-h"><span class="num">04</span><h2>Alerta</h2></div>
    <div class="note red"><h3>{{ c.alerta_titulo }}</h3><ul>{% for a in c.alerta %}<li>{{ a }}</li>{% endfor %}</ul></div>
  </section>

  <section class="anim">
    <div class="sec-h"><span class="num">05</span><h2>Próximo passo</h2></div>
    <div class="note blue"><ol>{% for p in c.proximos %}<li>{{ p }}</li>{% endfor %}</ol></div>
  </section>

  <footer class="anim">
    <span><b>{{ assinatura }}</b></span>
    <span>Gerado em {{ gerado_em }} · fonte: diário + aba semanal de criativos</span>
  </footer>
</div>
</body>
</html>
